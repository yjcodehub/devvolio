# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devvolio?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=super_secret_access_key_change_me_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_production_54321

# Cloudinary Config (For Project Media Manager & CV Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Settings (Allowed Frontend Origin)
FRONTEND_URL=http://localhost:3000
